{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "bindings": [
        {
          "type": "service",
          "service": "python-worker",
          "format": "url",
          "env": "PYTHON_WORKER_URL"
        }
      ]
    },
    "python-worker": {
      "root": "apps/python-worker",
      "runtime": "python"
    },
    "web": {
      "root": "apps/web",
      "framework": "angular"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
