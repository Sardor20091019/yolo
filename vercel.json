{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://yolo-zt3r.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://yolo-zt3r.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
