{
  "name": "yolo-shoplifting-detection",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/api/dist/main.js",
    "start:prod": "node apps/api/dist/main.js",
    "start:api": "npm --prefix apps/api run start:dev",
    "start:web": "npm --prefix apps/web run start",
    "start:worker": "python3 apps/python-worker/main.py",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "pip3 install --no-cache-dir -r apps/python-worker/requirements.txt 2>&1 || pip install --no-cache-dir -r apps/python-worker/requirements.txt 2>&1 || true; npm --prefix apps/api run build",
    "test:api": "npm --prefix apps/api run test",
    "test:worker": "python3 apps/python-worker/tests/test_heuristics.py"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "express": "^4.21.2",
    "typescript": "^5.7.2"
  }
}
